#!/bin/sh
#Data Path Session Table

if [ 0 -eq $# ]; then
    cat /proc/wap_proc/dp_session;
    cat /proc/wap_proc/dp_l2encap;
    return 0;
elif [ 2 -eq $# ]; then  
    if [ "clr" == $1 ]; then 
            if [ "all" == $2 ]; then 
                 write_proc /proc/wap_proc/dp_session clr_all;
                 return 0;
            elif [ "rule" == $2 ]; then 
                 write_proc /proc/wap_proc/dp_session clr_rule;
                 return 0;
            elif [ "l2" == $2 ]; then 
                 write_proc /proc/wap_proc/dp_session clr_l2;
                 return 0;
	        elif [ "hw" == $2 ]; then 
                 write_proc /proc/wap_proc/dp_session clr_hw;
                 return 0;
            else
                 echo "dpst clr [all|rule|l2|hw]";
                 return 1;
            fi
    elif [ "hw" == $1 ]; then
            if [ "on" == $2 ]; then 
                 write_proc /proc/wap_proc/dp_session hw_on;
                 return 0;
            elif [ "off" == $2 ]; then 
                 write_proc /proc/wap_proc/dp_session hw_off;
                 return 0;
            else
                 echo "dpst hw [on|off]";
                 return 1;
            fi
    elif [ "np" == $1 ]; then
            if [ "on" == $2 ]; then 
                 write_proc /proc/wap_proc/np_ip np_on;
                 return 0;
            elif [ "off" == $2 ]; then 
                 write_proc /proc/wap_proc/np_ip np_off;
                 return 0;
            else
                 echo "dpst np [on|off]";
                 return 1;
            fi
    fi
else
    echo "dpst clr [all|rule|l2|hw|ip|eth]";
    echo "dpst {hw|np} [on|off]";
    return 1;
fi

