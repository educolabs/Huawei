#!/bin/sh

# 此脚本只处理固定KO的加载和卸载
name=vse.ko
path=/lib/modules/wap/${name}
port=
ip=

# 不带参数为卸载操作
if [ $# -eq 1 ]; then
    if [ "$1" == "${name}" ] || [ "$1" == "${path}" ]; then
        rmmod ${path} > /dev/null 2>&1
    fi

    exit $?
fi

# 带参数为加载操作
if [ $# -ne 3 ] || [ "$1" != "${path}" ] ; then
    exit 1
fi

if [ $2 -ge 0 ] &>/dev/null; then
    port=$2
fi

if [ $3 -ge 0 ] &>/dev/null; then
    ip=$3
fi

if [ -z "${port}" ] || [ -z "${ip}" ]; then
    exit 1
fi

insmod ${path} vseport=${port} vseip=${ip} > /dev/null 2>&1

exit $?
