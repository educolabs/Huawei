{
  "$schema": "https://opencode.ai/config.json",
  "model": "alibaba/qwen3.7-plus",
  "small_model": "alibaba/qwen3.7-plus",
  "plugin": [
    "@zenobius/opencode-background@latest",
    "opencode-agent-skills@latest",
    "opencode-agent-memory@latest",
    "@spoons-and-mirrors/subtask2@latest",
    "opentmux@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-swarm-plugin@latest"
  ],
  "compaction": {
      "auto": true,
      "prune": true,
      "reserved": 10000
  },
  "enabled_providers": [
      "alibaba"
  ],
  "provider": {
    "alibaba": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "alibaba",
      "env": [
        "DASHSCOPE_API_KEY"
      ],
      "options": {
        "apiKey": "{env:DASHSCOPE_API_KEY}",
        "baseURL": "https://ws-4yexytxtu73rz2f4.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        "qwen3.7-plus": {
          "name": "Qwen 3.7 Plus",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "temperature": true
        }
      }
    }
  }
}
